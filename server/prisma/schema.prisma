generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  username  String?
  bio       String?
  image     String?
  ble_id    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}